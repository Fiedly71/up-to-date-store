# Base de données
DATABASE_URL="postgresql://user:password@localhost:5432/updatetech"

# Site (utilisé pour les redirections Stripe success/cancel, sitemap)
NEXT_PUBLIC_SITE_URL="https://uptodateelectronic.com"

# Session / Auth du POS interne
SESSION_SECRET="remplace-par-une-longue-chaine-aleatoire"

# Slug secret du POS — choisis quelque chose de non-devinable,
# jamais partagé publiquement, jamais commité en clair dans le code.
# Exemple (à changer) : ADMIN_GATE_SLUG="ops-7f2ac91"
ADMIN_GATE_SLUG=""

# Secret pour sécuriser les appels cron (rapport quotidien, libération des
# réservations de stock, relance panier abandonné). Vercel Cron ajoute
# automatiquement "Authorization: Bearer <CRON_SECRET>" quand cette variable
# est définie — à reconfirmer dans la doc Vercel Cron Jobs au déploiement.
CRON_SECRET="remplace-par-une-longue-chaine-aleatoire"

# Paiements (Stripe uniquement pour l'instant, Moncash plus tard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Taux de change USD -> HTG affiché sur le site (à mettre à jour
# régulièrement, les taux fluctuent beaucoup en Haïti)
NEXT_PUBLIC_USD_TO_HTG_RATE="144"

# Emails (reçus clients + brief reçu + rapport quotidien + panier abandonné)
RESEND_API_KEY=""
EMAIL_FROM="UpDate <commandes@uptodateelectronic.com>"
ADMIN_EMAIL="Fiedly250@gmail.com"

# Notifications WhatsApp/SMS (Twilio) — optionnel, no-op si absent
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
ADMIN_WHATSAPP_TO="whatsapp:+50932836938"

# Adresse de la boutique physique (pour la carte Google Maps sur l'accueil)
NEXT_PUBLIC_STORE_ADDRESS="Champin, Cap-Haïtien, Haïti"

# SEO / Marketing — analytics (optionnels, no-op si absents)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Suivi d'erreurs en production (optionnel, no-op si absent).
# Crée un projet gratuit sur sentry.io pour obtenir ce DSN.
NEXT_PUBLIC_SENTRY_DSN=""

# Upload d'image depuis le dashboard Stock (optionnel). Ajoute l'intégration
# "Blob" à ton projet Vercel pour obtenir ce token automatiquement — sinon,
# le dashboard permet toujours de coller une URL d'image directement.
BLOB_READ_WRITE_TOKEN=""

# Création du premier compte admin (script prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@uptodateelectronic.com"
SEED_ADMIN_PASSWORD="change-moi-immediatement"
